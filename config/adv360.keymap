#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        tg: tg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp LS(G) &kp LS(G) &kp LS(U)>;
            label = "TG";
        };

        strat_email: strat_email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D &kp R &kp E &kp W &kp DOT &kp T &kp H &kp O &kp M &kp P &kp S &kp O &kp N &kp AT &kp S &kp T &kp R &kp A &kp T &kp I &kp F &kp O &kp R &kp M &kp DOT &kp D &kp I &kp G &kp I &kp T &kp A &kp L>;
            label = "STRAT_EMAIL";
        };

        ato: ato {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D &kp R &kp E &kp W &kp DOT &kp M &kp DOT &kp T &kp H &kp O &kp M &kp P &kp S &kp O &kp N &kp AT &kp O &kp U &kp T &kp L &kp O &kp O &kp K &kp DOT &kp C &kp O &kp M>;
            label = "ATO";
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(LEFT_SHIFT)))>, <&macro_press>;

            label = "HYPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1        &kp N2    &kp N3     &kp N4        &kp N5  &tog 4                                                                                           &mo 3                  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q         &kp W     &kp E      &kp R         &kp T   &kp F13                                                                                          &kp LS(LA(LC(LG(W))))  &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp LCTRL  &kp A         &kp S     &kp D      &kp F         &kp G   &kp GRAVE               &kp LG(SPACE)    &kp DELETE    &ato          &kp LG(GRAVE)               &kp F13                &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z         &kp X     &kp C      &kp V         &kp B                                            &kp F13       &strat_email                                                     &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp LEFT_ALT  &kp LEFT  &kp RIGHT  &kp LEFT_GUI                     &lt 2 ENTER  &lt 5 BACKSPACE  &kp END       &kp EQUAL     &kp BACKSPACE  &lt 1 SPACE                                 &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        Arrow {
            bindings = <
&trans  &trans        &trans                &kp LA(UP)    &trans                 &trans         &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp HOME              &kp UP        &kp END                &trans         &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(LEFT)  &kp LEFT              &kp DOWN      &kp RIGHT              &kp LA(RIGHT)  &trans          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp LG(LEFT_BRACKET)  &kp LA(DOWN)  &kp LG(RIGHT_BRACKET)  &trans                                 &trans    &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans                &trans        &trans                                        &trans  &trans  &trans    &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 0                                                   &mo 3   &kp F7  &kp F8  &kp F9                &kp F10                &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                   &none   &trans  &trans  &kp LS(LEFT_BRACE)    &kp LS(RIGHT_BRACE)    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &hyper          &trans  &trans    &trans  &trans         &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                         &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &mo 3                  &trans  &trans                &trans                 &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans       &bt BT_NXT  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader  &none       &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_PRV  &bt BT_NXT                   &trans       &none       &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                                    &none    &none                                                 &none       &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                           &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                                    &mo 3  &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                     &none  &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none             &kp LCTRL  &kp LALT    &kp LGUI   &kp RCTRL             &none  &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                &kp HOME    &kp PG_UP                               &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                  &kp BSPC  &kp DEL    &kp END     &kp PG_DN  &kp ENTER  &kp KP_N0                 &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans          &trans                                                        &trans  &trans  &trans    &trans     &trans    &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_UP    &trans                                                        &trans  &trans  &trans    &trans     &trans    &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans          &trans  &trans    &trans  &trans              &trans  &trans  &mkp MB1  &mkp MCLK  &mkp MB2  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans                                  &trans    &trans                              &trans  &trans    &trans     &trans    &trans  &trans
&trans  &trans  &trans          &trans          &trans                                   &trans  &trans  &trans    &trans  &mkp MB4  &mkp MB5                  &trans    &trans     &trans    &trans  &trans
            >;
        };
    };
};
